---
import { formatDate, isoDate } from '../lib/dates';
import { formatStars, toolPath, type Tool } from '../lib/tools';

interface Props {
  tools: Tool[];
  /** Úroveň nadpisu karty podle okolní stránky (pod h1 je to h2, pod h2 h3). */
  headingLevel?: 2 | 3;
  showVerified?: boolean;
}

const { tools, headingLevel = 3, showVerified = false } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
---

<ul class="tools">
  {
    tools.map((tool) => (
      <li class="tool">
        <span class="tool__kind mono">{tool.data.kind}</span>
        <Heading class="tool__title">
          <a href={toolPath(tool)}>{tool.data.title}</a>
        </Heading>
        <p class="tool__description">{tool.data.description}</p>
        <dl class="tool__meta mono">
          <div>
            <dt>hvězdy:</dt>
            <dd>{tool.data.stars === undefined ? 'bez veřejného repozitáře' : formatStars(tool.data.stars)}</dd>
          </div>
          {showVerified && (
            <div>
              <dt>ověřeno:</dt>
              <dd>
                <time datetime={isoDate(tool.data.verifiedDate)}>{formatDate(tool.data.verifiedDate)}</time>
              </dd>
            </div>
          )}
        </dl>
      </li>
    ))
  }
</ul>

<style>
  @layer components {
    .tools {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
      gap: var(--space-4);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .tool {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      padding: 1.25rem;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--surface);
    }

    .tool__kind {
      color: var(--accent);
      font-size: 0.8125rem;
    }

    .tool__title {
      font-size: 1.25rem;
      line-height: 1.3;

      & a {
        color: var(--ink);
        text-decoration: none;

        &:hover {
          color: var(--accent);
          text-decoration: underline;
        }
      }
    }

    .tool__description {
      flex-grow: 1;
      color: var(--muted);
      font-size: 0.9375rem;
      line-height: 1.5;
    }

    .tool__meta {
      margin: var(--space-2) 0 0;
      color: var(--faint);
      font-size: var(--text-sm);
      line-height: 1.7;

      & div {
        display: flex;
        flex-wrap: wrap;
        gap: 0 var(--space-2);
      }

      & dd {
        margin: 0;
        color: var(--ink);
      }
    }
  }
</style>
