---
import { discussions, site } from '../site.config';
import { getPublishedTools, toolPath } from '../lib/tools';
import StatusBar from './StatusBar.astro';

const year = new Date().getFullYear();
// Stránka nástroje na tomto webu. Když je koncept, odkaz vede na oficiální stránky.
const openspecTool = (await getPublishedTools()).find((tool) => tool.id === 'openspec');
---

<footer class="footer">
  <div class="container footer__inner">
    <StatusBar />
    <div class="footer__row">
      <p>
        Vytvořeno pomocí {
          openspecTool ? (
            <a href={toolPath(openspecTool)}>OpenSpec</a>
          ) : (
            <a href={site.openspecUrl} rel="noopener">
              OpenSpec
            </a>
          )
        }{' · '}<a href={site.repo.url} rel="noopener">Kód a specifikace na GitHubu</a>{' · '}<a
          href={discussions.url}
          rel="noopener">Diskuze</a
        >{' · '}<a href={site.privacyPath}>Ochrana osobních údajů</a>
      </p>
      <p class="footer__copy">© {year} {site.author}</p>
    </div>
  </div>
</footer>

<style>
  @layer components {
    .footer {
      border-top: 1px solid var(--line);
      background: var(--surface);
      color: var(--muted);
      font-size: 0.9375rem;
      line-height: 1.6;
    }

    .footer__inner {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      padding-block: var(--space-5);
    }

    .footer__row {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-1) var(--space-5);
    }

    .footer__copy {
      color: var(--faint);
      font-size: var(--text-sm);
    }
  }
</style>
