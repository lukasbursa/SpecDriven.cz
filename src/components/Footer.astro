---
import { discussions, site } from '../site.config';
import StatusBar from './StatusBar.astro';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <StatusBar />
    <div class="footer__row">
      <p>
        Tento web byl vytvořen pomocí <a href={site.introArticlePath}>SDD</a>{' – '}<a
          href={site.openspecUrl}
          rel="noopener">OpenSpec</a
        >{' · '}<a href={site.repo.url} rel="noopener">Zdrojový kód a specifikace na GitHubu</a>{' · '}<a
          href={discussions.url}
          rel="noopener">Diskuze</a
        >
      </p>
      <div class="footer__legal">
        <p>© {year} {site.author}</p>
        <a href={site.privacyPath}>Ochrana osobních údajů</a>
        <!-- Odkryje a obslouží ho ConsentBanner. Bez JavaScriptu není co nastavovat. -->
        <button type="button" class="footer__consent" data-consent-open hidden>Nastavení cookies</button>
      </div>
    </div>
  </div>
</footer>

<style>
  @layer components {
    .footer {
      border-top: 1px solid var(--line);
      background: var(--surface);
      color: var(--muted);
      font-size: 0.9375rem;
      line-height: 1.6;
    }

    .footer__inner {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      padding-block: var(--space-5);
    }

    .footer__row {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-1) var(--space-5);
    }

    .footer__legal {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: var(--space-1) var(--space-4);
      color: var(--faint);
      font-size: var(--text-sm);
    }

    .footer__consent {
      padding: 0;
      border: 0;
      background: none;
      color: var(--accent);
      font: inherit;
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.2em;
      cursor: pointer;

      &[hidden] {
        display: none;
      }

      &:hover {
        text-decoration-thickness: 2px;
      }
    }
  }
</style>
