---
import type { StructuredData } from '../lib/structured-data';
import { site } from '../site.config';

interface Props {
  /** Název stránky. Bez něj jde o úvodní stránku. */
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Objekty ze `src/lib/structured-data.ts`, vypíšou se jako jeden @graph. */
  structuredData?: StructuredData[];
  /** Vyřadí stránku z indexu vyhledávačů (stránka 404). */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  type = 'website',
  publishedTime,
  modifiedTime,
  structuredData = [],
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : `${site.name} – ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(site.ogImage, Astro.site);

// Náhrada `<` drží JSON platný a text z metadat nemůže ukončit element <script>.
const jsonLd =
  structuredData.length > 0
    ? JSON.stringify({ '@context': 'https://schema.org', '@graph': structuredData }).replace(/</g, '\\u003c')
    : undefined;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={site.author} />
{noindex && <meta name="robots" content="noindex" />}
<link rel="canonical" href={canonical} />
<link rel="alternate" type="application/rss+xml" title={`${site.name} – články`} href="/rss.xml" />
<link rel="sitemap" href="/sitemap-index.xml" />

<meta property="og:title" content={title ?? fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={type} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content="cs_CZ" />
<meta property="og:site_name" content={site.name} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />
{/* Data pro vyhledávače, prohlížeč je nespouští. is:inline, jinak by z nich Astro udělalo modul. */}
{jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}
