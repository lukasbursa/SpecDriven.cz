---
import { site } from '../site.config';

const nav = [
  { href: '/clanky/', label: 'Články' },
  { href: '/nastroje/', label: 'Nástroje' },
  { href: '/jak-vznikl-tento-web/', label: 'Jak vznikl tento web' },
];

const path = Astro.url.pathname;

// Přesná shoda = aktuální stránka, jinak stránka uvnitř sekce (např. detail článku).
function current(href: string): 'page' | 'true' | undefined {
  if (path === href) return 'page';
  if (path.startsWith(href)) return 'true';
  return undefined;
}
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="wordmark">
      <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <rect x="2.5" y="2.5" width="19" height="19" rx="3" stroke-width="2"></rect>
        <path d="M7 12.5l3.2 3.2L17 8.8" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      <span>{site.name}</span>
    </a>
    <nav aria-label="Hlavní navigace">
      <ul class="nav">
        {
          nav.map(({ href, label }) => (
            <li>
              <a href={href} class="mark-h2" aria-current={current(href)}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <!-- Bez JavaScriptu zůstane skryté a režim se řídí systémem. Ikona ukazuje cílový režim. -->
    <button
      type="button"
      class="theme-toggle"
      aria-label="Tmavý režim"
      aria-pressed="false"
      title="Přepnout na tmavý režim"
      hidden
    >
      <svg class="theme-toggle__moon" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" stroke-width="2" stroke-linejoin="round"></path>
      </svg>
      <svg class="theme-toggle__sun" aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor">
        <circle cx="12" cy="12" r="4" stroke-width="2"></circle>
        <path
          d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"
          stroke-width="2"
          stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  // Ruční volba se ukládá jen, když se liší od systému. Shoda se systémem volbu smaže.
  const KEY = 'color-scheme';
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const systemDark = matchMedia('(prefers-color-scheme: dark)');

  // Bez light-dark() je záloha v tokens.css jen světlá a tmavá volba by nic neudělala.
  if (toggle && CSS.supports('color', 'light-dark(#000, #fff)')) {
    const system = () => (systemDark.matches ? 'dark' : 'light');
    const active = () => root.dataset.theme ?? system();

    const render = () => {
      const dark = active() === 'dark';
      toggle.setAttribute('aria-pressed', String(dark));
      toggle.title = dark ? 'Přepnout na světlý režim' : 'Přepnout na tmavý režim';
    };

    toggle.addEventListener('click', () => {
      const next = active() === 'dark' ? 'light' : 'dark';
      try {
        if (next === system()) localStorage.removeItem(KEY);
        else localStorage.setItem(KEY, next);
      } catch {
        // Zablokované úložiště: volba platí jen na této stránce.
      }
      if (next === system()) delete root.dataset.theme;
      else root.dataset.theme = next;
      render();
    });

    systemDark.addEventListener('change', render);

    // Stránka obnovená tlačítkem Zpět nespustí inline skript, volba se mezitím mohla změnit.
    addEventListener('pageshow', (event) => {
      if (!event.persisted) return;
      try {
        const scheme = localStorage.getItem(KEY);
        if (scheme === 'light' || scheme === 'dark') root.dataset.theme = scheme;
        else delete root.dataset.theme;
      } catch {}
      render();
    });

    render();
    toggle.hidden = false;
  }
</script>

<style>
  @layer components {
    .header {
      border-bottom: 1px solid var(--line);
    }

    .header__inner {
      /* Úzká obrazovka: název a přepínač v první řadě, navigace pod nimi. */
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'brand toggle'
        'nav nav';
      align-items: center;
      gap: var(--space-1) 0;
      padding-block: var(--space-3);

      & > nav {
        grid-area: nav;
      }

      /* Bod zlomu podle šířky názvu, navigace a přepínače v jednom řádku. */
      @media (min-width: 50rem) {
        grid-template-columns: auto 1fr auto;
        grid-template-areas: 'brand nav toggle';

        & > nav {
          justify-self: end;
          margin-inline-start: var(--space-6);
        }

        & > .theme-toggle {
          margin-inline-start: var(--space-4);
        }
      }
    }

    .wordmark {
      grid-area: brand;
      justify-self: start;
      display: flex;
      align-items: center;
      gap: 0.625rem;
      min-height: 44px;
      color: var(--ink);
      font-family: var(--font-code);
      font-size: 1.125rem;
      font-weight: 600;
      text-decoration: none;

      & svg {
        color: var(--accent);
      }
    }

    .nav {
      display: flex;
      flex-wrap: wrap;
      gap: 0 var(--space-6);
      margin: 0;
      padding: 0;
      list-style: none;
      font-family: var(--font-code);
      font-size: 0.9375rem;

      & a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        color: var(--ink);
        text-decoration: none;

        &:hover {
          color: var(--accent);
        }

        &[aria-current] {
          color: var(--accent);
          text-decoration: underline;
          text-decoration-thickness: 2px;
          text-underline-offset: 0.45em;
        }
      }
    }

    .theme-toggle {
      grid-area: toggle;
      display: inline-grid;
      place-items: center;
      inline-size: 44px;
      block-size: 44px;
      padding: 0;
      border: 0;
      border-radius: var(--radius-sm);
      background: none;
      color: var(--ink);
      cursor: pointer;

      &[hidden] {
        display: none;
      }

      &:hover {
        color: var(--accent);
      }

      &[aria-pressed='true'] .theme-toggle__moon,
      &[aria-pressed='false'] .theme-toggle__sun {
        display: none;
      }
    }
  }
</style>
