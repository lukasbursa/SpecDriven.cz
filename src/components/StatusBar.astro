---
// Stavový řádek: skutečný stav vývoje webu podle složky openspec/ v době buildu.
import { formatDateShort } from '../lib/dates';
import { getOpenSpecStatus } from '../lib/openspec-status';
import { repoTreeUrl } from '../site.config';

const { specs, archived, latest } = getOpenSpecStatus();
---

<p class="statusbar">
  <span class="statusbar__label">
    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor">
      <path d="M5 12.5l4.5 4.5L19 7.5" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
    stav vývoje
  </span>
  <span>specs: {specs}</span>
  <span>archivované změny: {archived}</span>
  {
    latest && (
      <span>
        poslední:{' '}
        <a href={repoTreeUrl(latest.path)} rel="noopener">
          {latest.name}
        </a>{' '}
        · {formatDateShort(latest.date)}
      </span>
    )
  }
</p>

<style>
  @layer components {
    .statusbar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-1) var(--space-5);
      padding: 0.625rem 0.875rem;
      border: 1px solid var(--line);
      border-radius: var(--radius-sm);
      background: var(--bg);
      color: var(--muted);
      font-family: var(--font-code);
      font-size: 0.8125rem;
      line-height: 1.6;
    }

    .statusbar__label {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;

      & svg {
        color: var(--accent);
      }
    }
  }
</style>
