---
import { render } from 'astro:content';
import Feedback from '../../components/Feedback.astro';
import Frontmatter, { type Entry } from '../../components/Frontmatter.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articlePath, getPublishedArticles, type Article } from '../../lib/articles';
import { ogImagePath } from '../../lib/og-image';
import { articleData, authorData, breadcrumbData } from '../../lib/structured-data';
import { discussions, repoEditUrl, site } from '../../site.config';

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const { title, description, pubDate, updatedDate, tags, discussion } = article.data;
const { Content } = await render(article);

const entries: Entry[] = [
  { key: 'publikováno', value: pubDate },
  ...(updatedDate ? [{ key: 'aktualizováno', value: updatedDate }] : []),
  { key: 'autor', value: site.author },
  ...(tags.length > 0 ? [{ key: 'štítky', value: `[${tags.join(', ')}]`, accent: true }] : []),
];

const image = ogImagePath(article) ?? site.ogImage;

const structuredData = [
  articleData(article, image),
  authorData(),
  breadcrumbData([
    { name: 'Články', path: '/clanky/' },
    { name: title, path: articlePath(article) },
  ]),
];
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
  structuredData={structuredData}
  image={image}
>
  <article class="container article">
    <p class="article__path mono"><a href="/clanky/">clanky</a> / {article.id}</p>

    <Frontmatter entries={entries} />

    <h1 class="article__title">{title}</h1>

    <div class="prose">
      <Content />
    </div>

    <Feedback discussion={discussion ?? discussions.categories.articles} editUrl={repoEditUrl(article.filePath!)} />
  </article>
</BaseLayout>

<style>
  @layer components {
    .article {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
      padding-block: var(--space-6) var(--space-8);
      /* Šířka obsahu pro srovnávací tabulky (100cqi), které přesahují sloupec textu. */
      container-type: inline-size;

      /* :global, aby pravidlo platilo i pro kořen vnořených komponent. */
      & > :global(*) {
        max-width: var(--measure);
      }
    }

    .article__path {
      color: var(--faint);
      font-size: 0.8125rem;

      & a {
        color: inherit;
      }
    }

    .article__title {
      margin-top: var(--space-2);
      font-size: var(--text-h1);
      line-height: var(--leading-tight);
      letter-spacing: -0.015em;
    }
  }
</style>
