---
import ArticleList from '../components/ArticleList.astro';
import Scenario from '../components/Scenario.astro';
import ToolCards from '../components/ToolCards.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedArticles } from '../lib/articles';
import { getPublishedTools } from '../lib/tools';
import { site } from '../site.config';

const latest = (await getPublishedArticles()).slice(0, 5);
const tools = (await getPublishedTools()).slice(0, 6);

const cycle = [
  { name: 'Záměr', text: 'Proč změna vzniká a co má přinést.' },
  { name: 'Specifikace', text: 'Požadované chování jako požadavky a scénáře WHEN/THEN.' },
  { name: 'Plán', text: 'Technický návrh a rozpad práce na úkoly.' },
  { name: 'Implementace', text: 'Kód podle úkolů, od člověka i od AI asistenta.' },
  { name: 'Ověření', text: 'Kontrola výsledku proti scénářům ve specifikaci.' },
];
---

<BaseLayout>
  <section class="hero">
    <div class="container hero__inner">
      <p class="hero__label mono" aria-hidden="true">## Purpose</p>
      <h1 class="hero__title">Nejdřív specifikace.<br />Potom kód.</h1>
      <p class="hero__lead">
        Spec-driven development česky. Co to je, jak funguje a jaké nástroje pro něj existují.
      </p>
      <Scenario title="Nový čtenář" when="nevíte, co je spec-driven development">
        <a class="button" href={site.introArticlePath}>Začněte úvodním článkem →</a>
      </Scenario>
    </div>
  </section>

  <section class="container section" aria-labelledby="cyklus">
    <h2 id="cyklus" class="section__title mark-h2">Jak SDD funguje</h2>
    <p class="section__lead">Nástroje se liší v názvech kroků, ale většina z nich sleduje podobný cyklus.</p>
    <ol class="cycle">
      {
        cycle.map((step, i) => (
          <li class="cycle__step">
            <span class="cycle__number mono" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <span class="cycle__name">{step.name}</span>
            <span class="cycle__text">{step.text}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section-border">
    <div class="container section" aria-labelledby="nastroje">
      <div class="section__head">
        <h2 id="nastroje" class="section__title mark-h2">Nástroje pro SDD</h2>
        <a class="mono section__more" href="/nastroje/">Všechny nástroje →</a>
      </div>
      <ToolCards tools={tools} />
    </div>
  </section>

  <section class="section-border">
    <div class="container section" aria-labelledby="nejnovejsi">
      <div class="section__head">
        <h2 id="nejnovejsi" class="section__title mark-h2">Nejnovější články</h2>
        <a class="mono section__more" href="/clanky/">Všechny články →</a>
      </div>
      <ArticleList articles={latest} />
    </div>
  </section>
</BaseLayout>

<style>
  @layer components {
    .hero {
      border-bottom: 1px solid var(--line);
      background-color: var(--bg);
      background-image:
        linear-gradient(var(--grid) 1px, transparent 1px),
        linear-gradient(90deg, var(--grid) 1px, transparent 1px);
      background-size: 24px 24px;
    }

    .hero__inner {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
      padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem);
    }

    .hero__label {
      color: var(--faint);
      font-size: var(--text-sm);
    }

    .hero__title {
      max-width: 52rem;
      font-size: var(--text-hero);
      line-height: 1.08;
      letter-spacing: -0.02em;
    }

    .hero__lead {
      max-width: 40rem;
      color: var(--muted);
      font-size: var(--text-lead);
      line-height: 1.55;
    }

    .section {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      padding-block: var(--space-8);
    }

    .section-border {
      border-top: 1px solid var(--line);
    }

    .section__head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-2) var(--space-5);
    }

    .section__title {
      font-size: var(--text-h2);
    }

    .section__lead {
      max-width: 40rem;
      color: var(--muted);
    }

    .section__more {
      font-size: 0.9375rem;
    }

    .cycle {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
      gap: var(--space-4);
      margin: var(--space-3) 0 0;
      padding: 0;
      list-style: none;
    }

    .cycle__step {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      padding: 1.25rem;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--surface);
    }

    .cycle__number {
      color: var(--accent);
      font-size: 0.8125rem;
    }

    .cycle__name {
      font-size: 1.25rem;
      font-weight: 600;
      line-height: 1.3;
    }

    .cycle__text {
      color: var(--muted);
      font-size: 0.9375rem;
      line-height: 1.5;
    }
  }
</style>
