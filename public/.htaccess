# Konfigurace Apache pro SpecDriven.cz. Požadavky popisuje openspec/specs/hosting.
# Direktivy záměrně nejsou v <IfModule>: chybějící modul má shodit web chybou 500,
# ne tiše vypnout přesměrování nebo cache.

# Lokální cesta, ne URL: Apache vrátí obsah 404.html se stavem 404 bez přesměrování.
ErrorDocument 404 /404.html
Options -Indexes

RewriteEngine On

# DOČASNĚ: přesměrování HTTP → HTTPS je vypnuté. TLS ukončuje proxy hostingu
# a Apache vidí HTTP i HTTPS shodně (HTTPS=off, port 80, žádné X-Forwarded-*),
# každé pravidlo by proto přesměrovávalo HTTPS samo na sebe. Diagnostika hledá
# další hlavičky, podle kterých by se HTTPS dalo poznat. Odstranit po vyřešení.
RewriteRule ^ - [E=DBG_FEH:%{HTTP:Front-End-Https},E=DBG_XFSCH:%{HTTP:X-Forwarded-Scheme},E=DBG_XFPROT:%{HTTP:X-Forwarded-Protocol},E=DBG_XURL:%{HTTP:X-Url-Scheme},E=DBG_XFF:%{HTTP:X-Forwarded-For},E=DBG_XRIP:%{HTTP:X-Real-IP},E=DBG_VIA:%{HTTP:Via},E=DBG_H2:%{ENV:HTTP2},E=DBG_RADDR:%{REMOTE_ADDR},E=DBG_SADDR:%{SERVER_ADDR},E=DBG_XFH:%{HTTP:X-Forwarded-Host},E=DBG_XFSRV:%{HTTP:X-Forwarded-Server}]
Header always set X-Https-Debug "feh=%{DBG_FEH}e xfscheme=%{DBG_XFSCH}e xfprotocol=%{DBG_XFPROT}e xurl=%{DBG_XURL}e xff=%{DBG_XFF}e xrealip=%{DBG_XRIP}e via=%{DBG_VIA}e http2=%{DBG_H2}e remote=%{DBG_RADDR}e server=%{DBG_SADDR}e xfhost=%{DBG_XFH}e xfserver=%{DBG_XFSRV}e"

# www → doména bez www.
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://specdriven.cz%{REQUEST_URI} [R=301,L]

# Složka bez koncového lomítka → s lomítkem. Explicitně, protože DirectorySlash
# by za proxy přesměroval na http:// a vznikla by dvě přesměrování za sebou.
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.*[^/])$ https://specdriven.cz/$1/ [R=301,L]

# Soubory s hashem v názvu se nemění, prohlížeč je smí držet rok bez ověřování.
<If "%{REQUEST_URI} =~ m#^/_astro/#">
  Header set Cache-Control "public, max-age=31536000, immutable"
</If>

# Stránky si prohlížeč ověří u serveru při každém načtení.
<FilesMatch "\.html$">
  Header set Cache-Control "no-cache"
</FilesMatch>
