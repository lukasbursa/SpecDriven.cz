# Konfigurace Apache pro SpecDriven.cz. Požadavky popisuje openspec/specs/hosting.
# Direktivy záměrně nejsou v <IfModule>: chybějící modul má shodit web chybou 500,
# ne tiše vypnout přesměrování nebo cache.

# Lokální cesta, ne URL: Apache vrátí obsah 404.html se stavem 404 bez přesměrování.
ErrorDocument 404 /404.html
Options -Indexes

RewriteEngine On

# DOČASNÁ diagnostika: hodnoty, podle kterých se pozná HTTPS. Odstranit, až se
# přesměrování na HTTPS ověří na produkci.
RewriteRule ^ - [E=DBG_HTTPS:%{HTTPS},E=DBG_ENV_HTTPS:%{ENV:HTTPS},E=DBG_PORT:%{SERVER_PORT},E=DBG_SCHEME:%{REQUEST_SCHEME},E=DBG_XFP:%{HTTP:X-Forwarded-Proto},E=DBG_XFS:%{HTTP:X-Forwarded-Ssl},E=DBG_XFPORT:%{HTTP:X-Forwarded-Port}]
Header always set X-Https-Debug "https=%{DBG_HTTPS}e env_https=%{DBG_ENV_HTTPS}e port=%{DBG_PORT}e scheme=%{DBG_SCHEME}e xfp=%{DBG_XFP}e xfs=%{DBG_XFS}e xfport=%{DBG_XFPORT}e"

# HTTP → HTTPS. Hostingy hlásí HTTPS různě (Apache sám, nebo proxy před ním),
# přesměruje se proto jen tehdy, když HTTPS nehlásí žádný z ukazatelů.
# Samotné %{HTTPS} a X-Forwarded-Proto na hostingu nestačily, vznikla smyčka.
RewriteCond %{HTTPS} !=on
RewriteCond %{ENV:HTTPS} !=on
RewriteCond %{SERVER_PORT} !=443
RewriteCond %{REQUEST_SCHEME} !=https
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteCond %{HTTP:X-Forwarded-Ssl} !=on
RewriteCond %{HTTP:X-Forwarded-Port} !=443
RewriteRule ^ https://specdriven.cz%{REQUEST_URI} [R=301,L]

# www → doména bez www.
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://specdriven.cz%{REQUEST_URI} [R=301,L]

# Složka bez koncového lomítka → s lomítkem. Explicitně, protože DirectorySlash
# by za proxy přesměroval na http:// a vznikla by dvě přesměrování za sebou.
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.*[^/])$ https://specdriven.cz/$1/ [R=301,L]

# Soubory s hashem v názvu se nemění, prohlížeč je smí držet rok bez ověřování.
<If "%{REQUEST_URI} =~ m#^/_astro/#">
  Header set Cache-Control "public, max-age=31536000, immutable"
</If>

# Stránky si prohlížeč ověří u serveru při každém načtení.
<FilesMatch "\.html$">
  Header set Cache-Control "no-cache"
</FilesMatch>
